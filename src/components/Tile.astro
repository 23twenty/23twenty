---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import arrow from '../assets/opta_arrow@2x.png';

interface Props {
  title: string;
  image: ImageMetadata;
  href: string;
}

const { title, image, href } = Astro.props;
---

<li class="tile" data-reveal>
  <a href={href}>
    <Image src={image} alt={title} widths={[290, 580]} sizes="290px" class="tile-img" />
    <span class="label">
      <span class="label-inner">
        <span class="title">{title}</span>
        <img class="arrow" src={arrow.src} alt="" width="35" height="20" />
      </span>
    </span>
  </a>
</li>

<style>
  .tile {
    display: inline-block;
    max-width: 25%;
    margin: 3%;
    vertical-align: middle;
    font-size: 0;
    line-height: 0;
  }
  .tile a {
    position: relative;
    display: block;
    width: 290px;
    max-width: 100%;
    height: 386px;
  }
  .tile :global(.tile-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* A translucent card over the photo that turns solid on hover. */
  .label {
    position: absolute;
    inset: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    background-color: #fff;
    opacity: 0.5;
    transition: opacity 0.3s ease-out;
  }
  .tile:hover .label {
    opacity: 1;
  }
  .label-inner {
    display: block;
  }
  .title {
    font-family: var(--font-display);
    font-size: 36px;
    line-height: 100%;
    color: var(--ink);
    transition: color 0.2s linear;
  }
  .title:hover {
    color: var(--gold);
  }
  .arrow {
    display: block;
    width: 35px;
    height: 20px;
    margin: 30px auto 0;
    transition: transform 0.3s ease;
  }
  .tile:hover .arrow {
    transform: translateX(10px);
  }

  @media (max-width: 1020px) {
    .label {
      inset: 10px;
    }
  }
  @media (max-width: 750px) {
    .tile {
      display: block;
      max-width: 95%;
      margin: 3% auto 33px;
    }
    .tile a {
      margin-inline: auto;
    }
  }
</style>
