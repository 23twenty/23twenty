---
import logo from '../assets/Logo-Black.svg';

interface Props {
  section?: 'home' | 'photo' | 'video';
  weddings: string | null;
}

const { section, weddings } = Astro.props;
const links = [
  { href: '/', label: 'Home', current: section === 'home' },
  { href: '/photo/', label: 'Photo', current: section === 'photo' },
  { href: '/video/', label: 'Video', current: section === 'video' },
];
---

<header class="header measure">
  <div class="header-logo">
    <a href="/"><img src={logo.src} alt="23Twenty Media" width="150" /></a>
  </div>
  <button type="button" class="toggle" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu">
    <span></span><span class="second"></span><span></span>
  </button>
</header>

<!-- Full-screen menu; a click anywhere outside the links closes it. -->
<div class="menu" id="site-menu" hidden>
  <div class="menu-holder">
    <nav class="menu-nav" aria-label="Main">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} class:list={{ current: l.current }} aria-current={l.current ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
        {weddings && <li><a href={weddings} target="_blank" rel="noopener">Weddings</a></li>}
      </ul>
    </nav>
  </div>
</div>

<style>
  .header {
    position: relative;
  }
  .header-logo {
    padding: 80px 0;
    text-align: center;
  }
  .header-logo img {
    width: 150px;
    height: auto;
    transition: opacity 0.3s linear;
  }
  .header-logo img:hover {
    opacity: 0.8;
  }

  .toggle {
    position: absolute;
    top: 104px;
    right: 0;
    z-index: 1;
    width: 20px;
    height: 21px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .toggle span {
    display: block;
    width: 100%;
    height: 3px;
    margin-bottom: 6px;
    background-color: var(--ink);
  }
  .toggle span:last-child {
    margin-bottom: 0;
  }
  .toggle .second {
    transform: translate3d(10px, 0, 0);
    transition: transform 0.3s ease;
  }
  .toggle:hover .second {
    transform: none;
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 99;
    overflow: auto;
    background-color: #000;
    cursor:
      url('/close.png'),
      auto;
    opacity: 0;
    transition: opacity 0.3s ease;
    scrollbar-width: none;
  }
  .menu.is-open {
    opacity: 1;
  }
  .menu-holder {
    position: relative;
    width: 1270px;
    max-width: 100%;
    margin: 70px auto 0;
    color: #fff;
    transform: translateY(30px);
    transition: transform 0.3s ease;
  }
  .menu.is-open .menu-holder {
    transform: none;
  }
  .menu-nav {
    width: 50%;
    margin-left: auto;
  }
  .menu-nav ul {
    display: inline-block;
    margin-top: 60px;
    padding-left: 100px;
    list-style: none;
    font-weight: 300;
    text-align: left;
    cursor: auto;
  }
  .menu-nav a {
    display: block;
    padding: 10px 0;
    font-size: 24px;
    line-height: 24px;
    color: #fff;
  }
  .menu-nav a:hover,
  .menu-nav a.current {
    color: var(--gold);
  }

  @media (max-width: 1600px) {
    .menu-nav {
      width: 45%;
    }
  }
  @media (max-width: 1020px) {
    .header-logo {
      padding: 50px 0;
    }
    .toggle {
      top: 71px;
      right: 40px;
    }
    .menu-nav {
      width: 100%;
      text-align: center;
    }
    .menu-nav ul {
      margin-top: 30px;
      padding-left: 0;
      text-align: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu-holder {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.toggle');
  const menu = document.querySelector<HTMLElement>('#site-menu');

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) {
      menu.hidden = false;
      requestAnimationFrame(() => menu.classList.add('is-open'));
    } else {
      menu.classList.remove('is-open');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      setTimeout(() => (menu.hidden = true), reduce ? 0 : 300);
    }
  }

  toggle?.addEventListener('click', () => setOpen(true));
  // Clicking a link navigates; clicking anywhere else on the overlay closes it.
  menu?.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>
